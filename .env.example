# Copy this file to .env and set both required credentials.
# Restart the dev server after changing values.

# Required for web search and page retrieval.
# Get a token: https://brightdata.com/cp/setting/users
# Enter the token without a Bearer prefix.
BRIGHT_DATA_API_TOKEN=

# Required for the model configured in src/mastra/agents/web-agent.ts.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Leave empty for the default search and scraping tools.
# Otherwise, set one of: ecommerce, social, business, browser, geo.
# Setting a group disables search_engine_batch and scrape_batch.
# Unrecognized values fall back to the default tools.
BRIGHT_DATA_MCP_GROUPS=
